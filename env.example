# Copy this file to .env and edit. All values are optional; sensible defaults are built in.

# Comma-separated words that must appear in an internship title for it to be considered.
TARGET_ROLE_KEYWORDS=backend,node,software engineer

# Comma-separated Internshala category slugs to search. Valid examples:
# data-science, full-stack-development, machine-learning, software-development,
# web-development, artificial-intelligence-ai, mobile-app-development, product, ui-ux
TARGET_CATEGORIES=software-development,full-stack-development,web-development

# Titles containing any of these are skipped even if they match TARGET_ROLE_KEYWORDS.
NEGATIVE_KEYWORDS=marketing,sales,hr,content writing,graphic design,video,social media,seo,customer support

# Minimum stipend filter used in the Internshala search URL.
MIN_STIPEND=4000

# Hard cap on applications submitted in a single run.
MAX_APPLICATIONS=15

# true = fill and log every answer but never click Submit. Recommended for your first run.
DRY_RUN=true

# true = run Chromium headless. Keep false while you're still verifying selectors work.
HEADLESS=false

# Seconds-equivalent delay (ms) between processing internships, plus random jitter.
PER_INTERNSHIP_DELAY_MS=2000

# Path to your GitHub Copilot CLI binary if it's not on PATH as "copilot".
COPILOT_BIN=copilot
